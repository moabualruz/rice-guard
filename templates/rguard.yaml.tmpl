# .rguard.yaml — generated by rguard init
# Edit this file to customize your quality pipeline.
# Reference: https://rguard.dev/docs/config

version: "1"

project:
  name: {{project_name}}
  languages: {{languages}}
  topology: {{topology}}
  architecture: {{architecture}}

scanners:
  semgrep:
    enabled: {{semgrep_enabled}}
    rulesets:
      - p/default
  trivy:
    enabled: {{trivy_enabled}}
    scanners:
      - vuln
      - secret
  gitleaks:
    enabled: {{gitleaks_enabled}}
  jscpd:
    enabled: {{jscpd_enabled}}
    threshold: 10
  scc:
    enabled: true

fixers:
  formatters: true
  linters: true
  security: {{semgrep_enabled}}
  ast: false
  deps: true
  unsafe: false

filters:
  include: []
  exclude:
    - vendor/
    - node_modules/
    - target/
    - .git/
    - "*.generated.*"
    - dist/

output:
  format: json
  severity_threshold: warning
  include_evidence: true

hooks:
  pre-commit:
    enabled: {{pre_commit}}
    manager: lefthook
    checks:
      - security
      - cve

ci:
  provider: {{ci_provider}}
  diff_only: true
