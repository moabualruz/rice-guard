name: Code Quality
on: [push, pull_request]
jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install rguard
        run: curl -fsSL https://install.rguard.dev | sh
      - name: Scan
        run: rguard scan . --diff-only
        env:
          RGUARD_FAIL_ON: high
