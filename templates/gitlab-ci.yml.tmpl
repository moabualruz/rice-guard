stages:
  - quality

code-quality:
  stage: quality
  image: ubuntu:22.04
  before_script:
    - apt-get update -qq && apt-get install -y curl
    - curl -fsSL https://install.rguard.dev | sh
  script:
    - rguard scan . --diff-only
  variables:
    RGUARD_FAIL_ON: high
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
